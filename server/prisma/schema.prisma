generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  VENDOR
  COMPANY
}

enum RequirementStatus {
  OPEN
  CLOSED
  CANCELLED
  FILLED
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  REJECTED
  WITHDRAWN
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  passwordHash  String
  role          Role
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  vendorProfile VendorProfile?
  companyProfile CompanyProfile?
}

model VendorProfile {
  id              String        @id @default(cuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id])
  name            String
  score           Float         @default(0)
  experienceYears Int           @default(0)
  strengths       Json?
  bio             String?
  avgRating       Float         @default(0)
  reviews         Review[]
  applications    Application[]
}

model CompanyProfile {
  id           String         @id @default(cuid())
  userId       String         @unique
  user         User           @relation(fields: [userId], references: [id])
  name         String
  industry     String?
  size         String?
  requirements Requirement[]
  reviews      Review[]       @relation("CompanyReviews")
}

model Requirement {
  id            String            @id @default(cuid())
  companyId     String
  company       CompanyProfile    @relation(fields: [companyId], references: [id])
  title         String
  description   String
  location      String?
  employmentType String?
  skills        Json?
  headcount     Int               @default(1)
  budgetMin     Int?
  budgetMax     Int?
  experienceMin Int               @default(0)
  status        RequirementStatus @default(OPEN)
  createdAt     DateTime          @default(now())
  applications  Application[]
}

model Application {
  id             String            @id @default(cuid())
  requirementId  String
  requirement    Requirement       @relation(fields: [requirementId], references: [id])
  vendorId       String
  vendor         VendorProfile     @relation(fields: [vendorId], references: [id])
  message        String?
  status         ApplicationStatus @default(APPLIED)
  scoreMatch     Float             @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([requirementId, vendorId])
}

model Review {
  id                 String         @id @default(cuid())
  vendorId           String
  vendor             VendorProfile  @relation(fields: [vendorId], references: [id])
  reviewerCompanyId  String
  reviewerCompany    CompanyProfile @relation("CompanyReviews", fields: [reviewerCompanyId], references: [id])
  rating             Int
  comment            String?
  createdAt          DateTime       @default(now())
}
